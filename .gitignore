# =============================================================================
# PATINA public repository allowlist
# =============================================================================
# SAFETY MODEL:
#   1. Ignore everything by default.
#   2. Re-allow only curated source/project files.
#   3. Re-ignore secrets, caches, build outputs, generated data, docs,
#      archives, venvs, node_modules, scratch/runs, and local machine state.
# =============================================================================

# -----------------------------------------------------------------------------
# Default deny
# -----------------------------------------------------------------------------
*
!*/

# -----------------------------------------------------------------------------
# Root-level public files
# -----------------------------------------------------------------------------
!.gitignore
!Cargo.toml
!Cargo.lock
!Justfile
!LICENSE
!LICENSES.md
!PROJECT_SUMMARY.md
!README.md
!README

!.github/
!.github/**/

# Keep these only if you want the Python helper/package published.
!pyproject.toml
!uv.lock

# -----------------------------------------------------------------------------
# Public source trees
# -----------------------------------------------------------------------------
!crates/
!crates/**/

!python/
!python/**/

!tools/
!tools/**/

!guide/
!guide/**/

!demo_notebooks/
!demo_notebooks/**/

# Optional public experiment/source tree.
!symmetry_experiment/
!symmetry_experiment/**/

!patina_debugging/
!patina_debugging/**/

# -----------------------------------------------------------------------------
# Allow source, config, docs-like lightweight files inside allowed source trees
# -----------------------------------------------------------------------------
!**/*.rs
!**/*.py
!**/*.pyi
!**/*.toml
!**/*.lock
!**/*.yaml
!**/*.yml
!**/*.json
!**/*.ipynb
!**/*.md
!**/*.txt
!**/*.rst
!**/*.typ
!**/*.bib
!**/*.tex
!**/*.sh
!**/*.bash
!**/*.zsh
!**/*.fish
!**/*.js
!**/*.css
!**/*.svelte
!**/*.ts
!**/*.just
!**/Justfile
!**/Dockerfile
!**/*.dockerfile
!**/*.nix
!**/*.ron
!**/*.csv.example
!**/*.env.example
!**/*.example
!**/*.template
!**/*.sample

# PATINA app build shims for optional browser-only dependencies.
!crates/patina-app/web/vendor/*.js

# Curated guide artwork.
!guide/src/assets/**/*.svg

# -----------------------------------------------------------------------------
# Lightweight deliberate scientific fixtures/examples only
# -----------------------------------------------------------------------------
!**/fixtures/**/*.xyz
!**/fixtures/**/*.cif
!**/fixtures/**/*.mol
!**/fixtures/**/*.mol2
!**/fixtures/**/*.sdf
!**/fixtures/**/*.pdb
!**/fixtures/**/*.csv
!**/fixtures/**/*.json

!**/examples/**/*.xyz
!**/examples/**/*.cif
!**/examples/**/*.mol
!**/examples/**/*.mol2
!**/examples/**/*.sdf
!**/examples/**/*.pdb
!**/examples/**/*.csv
!**/examples/**/*.json

# =============================================================================
# FINAL OVERRIDES: things that must never be published
# =============================================================================

# -----------------------------------------------------------------------------
# Do not publish docs from this working tree
# -----------------------------------------------------------------------------
docs/
docs/**
**/docs/0_old/
**/docs/0_old/**

# Generated guide/mdBook/notebook outputs
guide/book/
guide/notebook/_site/
**/book/
**/_site/
demo_notebooks/runs/
demo_notebooks/runs/**

# -----------------------------------------------------------------------------
# Secrets and credentials
# -----------------------------------------------------------------------------
**/.env
**/.env.*
**/*.env

# Real local vLLM runtime config; keep only *.env.example
crates/patina-llm/install/vllm/vllm.env
**/vllm.env
!**/*.env.example

**/*secret*
**/*secrets*
**/*credential*
**/*credentials*
**/*token*
**/*apikey*
**/*api_key*
**/*private*
**/*password*
**/*passwd*

# Re-allow clearly marked non-secret examples/templates after broad secret words.
!**/*secret*.example
!**/*secrets*.example
!**/*credential*.example
!**/*credentials*.example
!**/*token*.example
!**/*apikey*.example
!**/*api_key*.example
!**/*password*.example
!**/*passwd*.example
!**/*.template
!**/*.sample

**/*.pem
**/*.key
**/*.crt
**/*.csr
**/*.p12
**/*.pfx
**/*.asc
**/*.gpg

**/id_rsa
**/id_rsa.pub
**/id_ed25519
**/id_ed25519.pub
**/known_hosts
**/authorized_keys
**/ssh_config

**/credentials.json
**/client_secret*.json
**/service-account*.json
**/service_account*.json
**/gcloud*.json
**/firebase*.json
**/kaggle.json
**/wandb/
**/.netrc
**/.pypirc
**/.npmrc
**/.cargo/credentials
**/.cargo/credentials.toml

