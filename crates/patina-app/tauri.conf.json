{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "patina-app",
  "version": "0.1.0",
  "identifier": "com.patina.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "PATINA App",
        "width": 1400,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true
      }
    ]
  }
}
